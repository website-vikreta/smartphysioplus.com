{
  "name": "smartphysioplus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm content:check-duplication && pnpm content:check-faqs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "check-links": "node --experimental-strip-types --no-warnings scripts/check-links.mjs",
    "content:review-status": "node --experimental-strip-types --no-warnings scripts/review-status.ts",
    "content:check-duplication": "node --experimental-strip-types --no-warnings scripts/check-duplication.ts",
    "content-todo": "node --experimental-strip-types --no-warnings scripts/content-todo.mjs",
    "content:check-faqs": "node --experimental-strip-types --no-warnings scripts/check-faqs.ts",
    "audit:site": "node scripts/audit.mjs",
    "launch-report": "node --experimental-strip-types --no-warnings scripts/launch-report.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@next/third-parties": "^16.3.8",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@supabase/supabase-js": "^2.117.2",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "motion": "^14.0.0",
    "next": "16.3.8",
    "next-mdx-remote": "^6.0.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "resend": "^6.32.0",
    "simple-icons": "^16.34.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "axe-core": "^4.14.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.9",
    "puppeteer-core": "^25.14.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.7.1"
}
